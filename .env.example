# MASTER_USERNAME/VIEWER_USERNAME are internal identifiers only - nobody types
# them in. Master logs in with just MASTER_PASSWORD (no username prompt, it's
# always "you"). Viewer logs in with VIEWER_PASSWORD (one shared password)
# plus a freeform name typed at login time, used only for the login history.
MASTER_USERNAME=master
MASTER_PASSWORD=changeme-master
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=changeme-viewer
JWT_SECRET=change-this-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
LOGIN_RATE_LIMIT=5/minute
